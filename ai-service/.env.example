AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8100
AI_MODELS_DIR=../models
MAX_SERIES_LENGTH=72
DISTRESS_THRESHOLD=0.55

# Keep this enabled to try TensorFlow/PyTorch when installed.
# If the runtimes are missing, the service still verifies the final artifacts
# and returns deterministic artifact-backed predictions.
AI_LOAD_REAL_MODELS=1
